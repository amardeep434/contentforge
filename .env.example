# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Video pipeline (`pipeline make`). All of these have working defaults baked in,
# so on a machine with the local services running you need set NONE of them -
# they are listed here only to show what can be overridden. See
# docs/setup/running-the-pipeline.md, local-image-generation.md, local-voice.md.
# ---------------------------------------------------------------------------
# LLM for the spec/metadata stages. Any OpenAI-compatible endpoint (OmniRoute).
# CONTENTFORGE_LLM_BASE_URL=http://127.0.0.1:20128/v1
# CONTENTFORGE_LLM_MODEL=auto/best-free
# CONTENTFORGE_LLM_KEY=                      # blank is fine for a local server
# Narration: omnivoice (local, offline, no key) is the default; edge is a
# low-quality fallback. Reference clip: ~/.local/share/contentforge/voices/iapetus-reference.wav
# CONTENTFORGE_VOICE_BACKEND=omnivoice
# CONTENTFORGE_VOICE_REFERENCE=              # override path to the reference wav
# Image model: qwen (default, best quality) | flux (faster) | stabilityai/sdxl-turbo (draft only)
# CONTENTFORGE_IMAGE_MODEL=qwen
# CONTENTFORGE_IMAGE_WIDTH=768               # generation size; output is always 1920x1080
# CONTENTFORGE_IMAGE_HEIGHT=432

# YouTube Data API v3 key (Google Cloud Console → enable YouTube Data API v3)
YOUTUBE_API_KEY=

# Filled in during Plan 4, once Meta App Review completes.
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# META_ACCESS_TOKEN=

# Optional named credentials for key rotation or a separate registered API
# Client. Each profile keeps its own independent quota ledger; the pipeline
# never fails over between them, because the YouTube API Developer Policies
# require exactly one API Project per API Client.
# YOUTUBE_API_KEY_ROTATE=

# Authoritative quota reads (optional but strongly recommended).
# Cloud Monitoring is IAM-scoped: it needs a service account with
# roles/monitoring.viewer, NOT an API key. Without these the pipeline falls
# back to its local forecast and warns that it is doing so.
# YOUTUBE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
