# Copy to .env and fill in. .env is gitignored and must never be committed.

# YouTube Data API v3 key (Google Cloud Console → enable YouTube Data API v3)
YOUTUBE_API_KEY=

# Filled in during Plan 4, once Meta App Review completes.
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# META_ACCESS_TOKEN=

# Optional named credentials for key rotation or a separate registered API
# Client. Each profile keeps its own independent quota ledger; the pipeline
# never fails over between them, because the YouTube API Developer Policies
# require exactly one API Project per API Client.
# YOUTUBE_API_KEY_ROTATE=

# Authoritative quota reads (optional but strongly recommended).
# Cloud Monitoring is IAM-scoped: it needs a service account with
# roles/monitoring.viewer, NOT an API key. Without these the pipeline falls
# back to its local forecast and warns that it is doing so.
# YOUTUBE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
